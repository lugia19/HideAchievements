{
    "name": "HideAchievements",
    "author": "lugia19",
    "description": "Toggle visibility of game page sections: Activity feed, Achievements, Trading Cards, and the mini achievements bar.",
    "version": "1.1.0",
    "tags": [
        "Tweak",
        "Minimal",
        "Game page"
    ],
    "Steam-WebKit": "webkit.css",
    "UseDefaultPatches": true,
    "Conditions": {
        "Activity feed :": {
            "tab": "Game page",
            "description": "> Control visibility of the Activity feed section on game pages.\n\n - Show : Show normally.\n - Hide : Hide entirely.\n - On hover : Hide contents but keep the header; reveal on hover.",
            "default": "On hover",
            "values": {
                "Show": {},
                "Hide": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "elements/options/activity/hide.css"
                    }
                },
                "On hover": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "elements/options/activity/hover.css"
                    }
                }
            }
        },
        "Achievements section :": {
            "tab": "Game page",
            "description": "> Control visibility of the Achievements section on game pages.\n\n - Show : Show normally.\n - Hide : Hide entirely.\n - On hover : Hide contents but keep the header; reveal on hover.",
            "default": "On hover",
            "values": {
                "Show": {},
                "Hide": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "elements/options/achievements/hide.css"
                    }
                },
                "On hover": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "elements/options/achievements/hover.css"
                    }
                }
            }
        },
        "Trading Cards section :": {
            "tab": "Game page",
            "description": "> Control visibility of the Trading Cards section on game pages.\n\n - Show : Show normally.\n - Hide : Hide entirely.\n - On hover : Hide contents but keep the header; reveal on hover.",
            "default": "On hover",
            "values": {
                "Show": {},
                "Hide": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "elements/options/cards/hide.css"
                    }
                },
                "On hover": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "elements/options/cards/hover.css"
                    }
                }
            }
        },
        "Mini achievements bar :": {
            "tab": "Game page",
            "description": "> Hide the compact achievements progress bar shown next to the Play button.\n\n - Show : Show normally.\n - Hide : Hide entirely.",
            "default": "Hide",
            "values": {
                "Show": {},
                "Hide": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "elements/options/mini_achievements/hide.css"
                    }
                }
            }
        }
    }
}